FROM node:22-alpine
WORKDIR /app
ARG FLOWNIX_COMMIT_SHA=unverified-local-build
ENV WORKER_RELEASE_SHA=$FLOWNIX_COMMIT_SHA
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY patches patches
RUN --mount=type=cache,id=flownix-pnpm,target=/pnpm/store pnpm install --store-dir=/pnpm/store --frozen-lockfile --prod --filter @flownix/worker... --network-concurrency=4 --fetch-timeout=120000
# Keep the established repository-root CLI paths while using the worker's runtime loader.
RUN ln -s ../apps/worker/node_modules/tsx node_modules/tsx
COPY packages packages
COPY apps/worker apps/worker
COPY scripts/worker-health.ts scripts/worker-preflight.ts scripts/worker-status.ts scripts/operational-acceptance.ts scripts/provider-smoke.ts scripts/collection-status.ts scripts/db-verify.ts scripts/db-target.ts scripts/doctor.ts scripts/
COPY scripts/worker-duty.ts scripts/
USER node
HEALTHCHECK --interval=60s --timeout=15s --start-period=90s --retries=3 CMD ["node", "--import", "tsx", "scripts/worker-health.ts"]
CMD ["sh", "-c", "if [ \"$WORKER_EXECUTION_MODE\" = duty_cycle ]; then exec node --import tsx scripts/worker-duty.ts; else node --import tsx scripts/worker-preflight.ts && exec node --import tsx apps/worker/src/index.ts; fi"]
