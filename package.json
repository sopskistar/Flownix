{
  "name": "flownix",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @flownix/web dev",
    "build": "pnpm --filter @flownix/web build",
    "start": "pnpm --filter @flownix/web start",
    "worker:dev": "tsx --env-file-if-exists=.env apps/worker/src/index.ts",
    "worker:once": "tsx --env-file-if-exists=.env apps/worker/src/index.ts --once",
    "worker:verify": "tsx --env-file=.env.worker.local apps/worker/src/index.ts --once",
    "live:gate": "tsx --env-file=.env.worker.local apps/worker/src/acceptance.ts",
    "collection:status": "tsx --env-file=.env.worker.local scripts/collection-status.ts",
    "research:audit": "tsx --env-file=.env.worker.local scripts/research-audit.ts",
    "worker:profile": "node --env-file=.env.worker.local --import tsx apps/worker/src/index.ts --profile",
    "worker:profile:report": "node --import tsx scripts/worker-profile-report.ts",
    "worker:status": "node --env-file=.env.worker.local --import tsx scripts/worker-status.ts",
    "worker:preflight": "node --env-file=.env.worker.local --import tsx scripts/worker-preflight.ts",
    "worker:env": "node --import tsx scripts/worker-env.ts",
    "worker:cost": "node --import tsx scripts/worker-cost-report.ts",
    "worker:diagnostics": "tsx --env-file=.env.worker.local scripts/ingestion-diagnostics.ts",
    "worker:schedule": "tsx --env-file=.env.worker.local scripts/reconcile-scan-jobs.ts",
    "rpc:diagnose": "tsx --env-file=.env.worker.local scripts/rpc-diagnose.ts",
    "rpc:diagnose:solana": "tsx --env-file=.env.worker.local scripts/solana-diagnose.ts",
    "research:case": "tsx --env-file=.env.worker.local apps/worker/src/research-case.ts",
    "research:refresh": "node --env-file=.env.worker.local --import tsx apps/worker/src/research-refresh.ts",
    "db:migrate:production": "tsx --env-file=.env.worker.local packages/db/src/migrate.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env.deploy.local scripts/db-verify.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "providers:smoke": "tsx --env-file-if-exists=.env scripts/provider-smoke.ts",
    "providers:production": "tsx --env-file=.env.worker.local scripts/provider-smoke.ts --persist --rpc",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit:deps": "pnpm audit --prod",
    "brand:export": "node scripts/export-brand.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
