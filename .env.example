DATABASE_URL=postgresql://flownix:flownix@127.0.0.1:5432/flownix
# Direct session connection for long-running worker/migrations. No transaction pooler for advisory locks.
DATABASE_URL_WORKER=postgresql://flownix:flownix@127.0.0.1:5432/flownix
ACCESS_MODE=local
# For remote hosting set ACCESS_MODE=oauth and all values below. GitHub allowlist is required.
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=sopskistar
# Optional trusted RPC URLs: server configuration only, never editable from browser.
# Optional process-local DNS resolvers (IP addresses, comma separated). Empty uses system DNS.
# Use only to repair a diagnosed resolver failure; TLS/origins/access restrictions remain unchanged.
PROVIDER_DNS_SERVERS=
# Optional bounded local profiling only. Zero means no process request cap/time limit.
PROVIDER_PROCESS_REQUEST_BUDGET=0
WORKER_RUN_SECONDS=0
WORKER_JOB_TIMEOUT_SECONDS=900
# Leave empty/unset for the full production job schedule. Diagnostic subset only.
# WORKER_JOB_KINDS=registry,scan,persistence
# WORKER_PLATFORM=linux
BSC_RPC_URL=https://bsc-rpc.publicnode.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
SCAN_BLOCKS=100
SCAN_CONFIRMATIONS=20
DEEP_TOKEN_LIMIT=15
MARKET_TOKEN_LIMIT=15
ALPHA_REQUESTS_PER_MINUTE=30
TRANSFER_MIN_EVENTS=25
TRANSFER_BASELINE_MULTIPLIER=3
TRANSFER_BASELINE_WINDOWS=12
SIGNAL_COOLDOWN_MINUTES=60
MIN_LIQUIDITY_USD=100000
MAX_DATA_AGE_SECONDS=900
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_WATCHLIST_ONLY=true
# No Nansen network calls are implemented; cost guard defaults deny.
PAID_ENRICHMENT_ENABLED=false
PAID_DAILY_BUDGET_USD=0
